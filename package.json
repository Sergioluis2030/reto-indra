{
  "name": "rimac-appointment-backend",
  "version": "1.0.0",
  "description": "Backend de agendamiento de citas médicas - Reto Técnico Rimac (Serverless + Hexagonal)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "remove": "serverless remove",
    "offline": "serverless offline",
    "logs": "serverless logs -f appointment -t"
  },
  "keywords": [
    "serverless",
    "aws",
    "hexagonal",
    "typescript",
    "rimac"
  ],
  "author": "Reto Técnico Rimac",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "serverless": "^3.39.0",
    "serverless-offline": "^13.8.1",
    "serverless-plugin-typescript": "^2.1.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.679.0",
    "@aws-sdk/client-eventbridge": "^3.679.0",
    "@aws-sdk/client-sns": "^3.679.0",
    "@aws-sdk/lib-dynamodb": "^3.679.0",
    "mysql2": "^3.11.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
